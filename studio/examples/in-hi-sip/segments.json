[
 {
  "text": "\u092a\u093e\u0901\u091a \u0939\u091c\u093c\u093e\u0930 \u0930\u0941\u092a\u092f\u0947 \u092e\u0939\u0940\u0928\u0947 \u0915\u093e SIP, \u092a\u091a\u093e\u0938 \u0932\u093e\u0916 \u092c\u0928 \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0924\u094b \u092b\u093f\u0930 \u0906\u092a\u0915\u093e SIP \u092c\u0947\u0915\u093e\u0930 \u0915\u094d\u092f\u094b\u0902 \u0932\u0917\u0924\u093e \u0939\u0948?",
  "start": 0.0,
  "end": 7.223
 },
 {
  "text": "\u092e\u093e\u0928 \u0932\u0940\u091c\u093f\u090f, \u0906\u092a \u0939\u0930 \u092e\u0939\u0940\u0928\u0947 \u092a\u093e\u0901\u091a \u0939\u091c\u093c\u093e\u0930 \u0930\u0941\u092a\u092f\u0947 \u0907\u0928\u094d\u0935\u0947\u0938\u094d\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964",
  "start": 7.503,
  "end": 11.521
 },
 {
  "text": "\u092a\u093e\u0901\u091a \u0938\u093e\u0932 \u092c\u093e\u0926, \u0906\u092a\u0928\u0947 \u0924\u0940\u0928 \u0932\u093e\u0916 \u0921\u093e\u0932\u0947\u0964 \u0935\u0948\u0932\u094d\u092f\u0942 \u0932\u0917\u092d\u0917 \u091a\u093e\u0930 \u0932\u093e\u0916\u0964 \u0938\u094d\u0932\u094b \u0932\u0917\u0924\u093e \u0939\u0948\u0964",
  "start": 11.801,
  "end": 16.926
 },
 {
  "text": "\u0926\u0938 \u0938\u093e\u0932 \u092c\u093e\u0926: \u091b\u0939 \u0932\u093e\u0916 \u0921\u093e\u0932\u0947\u0964 \u0935\u0948\u0932\u094d\u092f\u0942 \u0932\u0917\u092d\u0917 \u0938\u093e\u0922\u093c\u0947 \u0917\u094d\u092f\u093e\u0930\u0939 \u0932\u093e\u0916\u0964",
  "start": 17.206,
  "end": 21.238
 },
 {
  "text": "\u092c\u0940\u0938 \u0938\u093e\u0932 \u092c\u093e\u0926: \u092c\u093e\u0930\u0939 \u0932\u093e\u0916 \u0921\u093e\u0932\u0947\u0964 \u0935\u0948\u0932\u094d\u092f\u0942 \u0932\u0917\u092d\u0917 \u092a\u091a\u093e\u0938 \u0932\u093e\u0916\u0964",
  "start": 21.518,
  "end": 25.443
 },
 {
  "text": "\u0935\u0939\u0940 SIP, \u0935\u0939\u0940 \u0905\u092e\u093e\u0909\u0902\u091f\u0964 \u092c\u0938 \u0917\u094d\u0930\u094b\u0925 \u0926\u0947\u0930 \u0938\u0947 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0964",
  "start": 25.723,
  "end": 29.407
 },
 {
  "text": "\u092f\u0939\u0940 \u0939\u0948 \u0915\u0902\u092a\u093e\u0909\u0902\u0921\u093f\u0902\u0917\u0964 \u0906\u092a\u0915\u0947 \u0930\u093f\u091f\u0930\u094d\u0928\u094d\u0938, \u0905\u092a\u0928\u0947 \u0916\u0941\u0926 \u0915\u0947 \u0930\u093f\u091f\u0930\u094d\u0928\u094d\u0938 \u0915\u092e\u093e\u0928\u0947 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964",
  "start": 29.687,
  "end": 34.645
 },
 {
  "text": "\u0914\u0930 \u091c\u093c\u094d\u092f\u093e\u0926\u093e\u0924\u0930 \u0932\u094b\u0917 \u0924\u0940\u0938\u0930\u0947 \u0938\u093e\u0932 \u092e\u0947\u0902 \u091b\u094b\u0921\u093c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902, \u0920\u0940\u0915 \u0924\u092c \u091c\u092c \u0915\u0930\u094d\u0935 \u092e\u0941\u0921\u093c\u0928\u0947 \u0935\u093e\u0932\u093e \u0939\u094b\u0924\u093e \u0939\u0948\u0964",
  "start": 34.925,
  "end": 40.503
 },
 {
  "text": "\u092f\u0939 \u092c\u093e\u0930\u0939 \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u0938\u093e\u0932\u093e\u0928\u093e \u092e\u093e\u0928\u0915\u0930 \u0939\u0948\u0964 \u0905\u0938\u0932\u0940 \u0930\u093f\u091f\u0930\u094d\u0928\u094d\u0938 \u090a\u092a\u0930 \u0928\u0940\u091a\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902, \u0914\u0930 \u0915\u0941\u091b \u092d\u0940 \u0917\u093e\u0930\u0902\u091f\u0940\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964",
  "start": 40.783,
  "end": 47.582
 },
 {
  "text": "\u0924\u094b \u0905\u092a\u0928\u0947 SIP \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u093e\u0932 \u0938\u0947 \u092e\u0924 \u0906\u0901\u0915\u093f\u090f\u0964 \u092a\u0902\u0926\u094d\u0930\u0939\u0935\u0947\u0902 \u0938\u093e\u0932 \u0938\u0947 \u0906\u0901\u0915\u093f\u090f\u0964",
  "start": 47.862,
  "end": 52.884
 }
]